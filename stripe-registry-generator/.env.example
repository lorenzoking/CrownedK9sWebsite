# ──────────────────────────────────────────────────────────────
# Stripe Registry Generator – environment variables
# Copy this file to `.env` in the same folder and fill in values.
# ──────────────────────────────────────────────────────────────

# Required. Your Stripe secret key.
# Use a TEST key (sk_test_...) while you dry-run, then swap to a LIVE key (sk_live_...) once the links look right.
STRIPE_SECRET_KEY=

# Optional. Default success URL Stripe redirects to after a gift is completed.
# Each registry item can override this with its own `success_url` in registry-items.json.
DEFAULT_SUCCESS_URL=https://crownedk9s.com/our-pack-is-growing?gift=received
